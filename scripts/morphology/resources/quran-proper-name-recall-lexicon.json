{
  "contract": {
    "applies_only_to": "tokens v1.3 leaves RECALL_GAP / UNRESOLVED_PROPER_NAME",
    "candidate_fields": [
      "lex",
      "pos",
      "root(null)",
      "prc0-prc3",
      "enc0",
      "source(quran_proper_name_lexicon)"
    ],
    "keyed_by": "canonical Tanzil surface - never a verse key",
    "never_synthesized": [
      "root",
      "cas",
      "gen",
      "num",
      "stt",
      "mod",
      "vox",
      "asp",
      "per"
    ],
    "pool_semantics": "the candidate is ADDED to the pool; nothing is removed",
    "proclitic_tags": "lexicon-namespaced; the surface proves the letter, not the syntactic subtype, so wa_conj/wa_sub-style tags are deliberately not asserted",
    "production_readiness": "entries whose name could not be independently confirmed from the surface are marked production_ready=false and carry requires_manual_verification=true",
    "purpose": "supply one verifiable noun_prop candidate for the residual L7A surfaces, for which CAMeL produces no noun_prop analysis at all",
    "teacher_use": "build-time confirmation and veto only - never a runtime lookup, fingerprint or verse-key decision",
    "unique_parse_required": "a surface with more than one valid split against the closed name inventory yields no candidate"
  },
