{
  "name": "quran-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @quran-app/web",
    "dev:mobile": "npm run dev -w @quran-app/mobile",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "smoke:surah-context": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/smoke-surah-context.ts",
    "smoke:analysis-engine-v1": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/smoke-analysis-engine-v1.ts",
    "smoke:analysis-engine-v1:snapshots": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/smoke-analysis-engine-v1-snapshots.ts",
    "audit:analysis-engine-v1": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/audit-analysis-engine-v1.ts",
    "audit:analysis-engine-v1:sources": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/audit-analysis-engine-v1-sources.ts",
    "build:word-analysis:test": "node data2/scripts/build_word_analysis.js --surah 1 --ayah 1",
    "build:word-analysis:all": "node data2/scripts/build_word_analysis.js --all",
    "build:canonical-word-analysis:test": "node data2/scripts/build_canonical_word_analysis.js --surah 1 --ayah 1",
    "build:canonical-word-analysis:all": "node data2/scripts/build_canonical_word_analysis.js --all",
    "fill:root-explanations": "node --no-warnings --env-file=.env.local --loader ./scripts/ts-extension-loader.mjs scripts/fill-root-explanations.ts",
    "fill:root-explanations:test": "node --no-warnings --env-file=.env.local --loader ./scripts/ts-extension-loader.mjs scripts/fill-root-explanations.ts --test",
    "generate-meaning-summaries": "node --no-warnings --env-file=.env.local --loader ./scripts/ts-extension-loader.mjs scripts/generate-meaning-summaries.ts",
    "generate-meaning-summaries:test": "node --no-warnings --env-file=.env.local --loader ./scripts/ts-extension-loader.mjs scripts/generate-meaning-summaries.ts --test",
    "repair-meaning-summaries": "node --no-warnings --env-file=.env.local --loader ./scripts/ts-extension-loader.mjs scripts/repair-meaning-summaries.ts",
    "repair-meaning-summaries:dry": "node --no-warnings --env-file=.env.local --loader ./scripts/ts-extension-loader.mjs scripts/repair-meaning-summaries.ts --dry-run"
  },
  "overrides": {
    "react":     "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "dotenv": "^17.4.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": "eslint --fix",
    "packages/**/*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.28",
    "eslint-plugin-react-hooks": "^4.6.2",
    "groq-sdk": "^1.2.0",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "simple-git-hooks": "^2.13.1"
  }
}
