{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@quran-app/types": [
        "packages/types/src"
      ],
      "@quran-app/core": [
        "packages/core/src"
      ],
      "@quran-app/ui": [
        "packages/ui/src"
      ],
      "@quran-app/storage": [
        "packages/storage/src"
      ]
    }
  }
}
