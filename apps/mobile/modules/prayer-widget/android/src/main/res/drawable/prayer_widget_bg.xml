<?xml version="1.0" encoding="utf-8"?>
<!-- Sıcak parşömen kart: fildişi→bej çok hafif dikey geçiş (angle 270 = üstten
     alta), 16dp köşe, 1dp soluk altın-ten kenarlık. Emir Ayetleri widget'ıyla
     aynı yüzey dili. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
    android:startColor="@color/prayer_widget_bg_top"
    android:endColor="@color/prayer_widget_bg_bottom"
    android:angle="270" />
  <corners android:radius="16dp" />
  <stroke android:width="1dp" android:color="@color/prayer_widget_border" />
</shape>
