<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis=1800000 (Android minimumu olan 30 dk): exact alarm izni
  YOKKEN statik görünümün "sıradaki vakti" en geç 30 dk gecikmeyle ilerletebilmesi
  ve olası sapmaların kendini düzeltmesi için ucuz, standart emniyet ağı.
  (Saniyelik canlı akış Chronometer'ın işi — launcher süreci kendisi çizer,
  bizim tarafta periyodik iş ÇALIŞMAZ.)
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="250dp"
  android:minHeight="110dp"
  android:targetCellWidth="4"
  android:targetCellHeight="2"
  android:resizeMode="horizontal"
  android:description="@string/prayer_widget_description"
  android:initialLayout="@layout/prayer_widget"
  android:updatePeriodMillis="1800000"
  android:widgetCategory="home_screen" />
