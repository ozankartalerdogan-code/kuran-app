<?xml version="1.0" encoding="utf-8"?>
<!--
  Namaz vakti widget yerleşimi. Üç durum, görünürlük RemoteViews ile yönetilir:
  • Canlı sayaç:  title="Sıradaki vakit: Akşam" + Chronometer "01:24:36 kaldı"
  • Statik:       title="Sıradaki vakit"        + static  "Akşam 20:41"
  • Hata/veri yok: title="Namaz Vakitleri"      + static  "…uygulamayı açın"
  Chronometer varsayılan GONE — başıboş sayaç asla görünmesin (negatif süre yasağı).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/prayer_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:background="@drawable/prayer_widget_bg"
  android:paddingLeft="14dp"
  android:paddingRight="14dp"
  android:paddingTop="10dp"
  android:paddingBottom="10dp">

  <TextView
    android:id="@+id/prayer_widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/prayer_widget_title_next"
    android:textColor="@color/prayer_widget_accent"
    android:textSize="12sp"
    android:textStyle="bold"
    android:singleLine="true"
    android:ellipsize="end" />

  <Chronometer
    android:id="@+id/prayer_widget_chrono"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:countDown="true"
    android:format="@string/prayer_widget_chrono_format"
    android:textColor="@color/prayer_widget_text"
    android:textSize="22sp"
    android:textStyle="bold"
    android:singleLine="true"
    android:visibility="gone" />

  <TextView
    android:id="@+id/prayer_widget_static"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="@string/prayer_widget_open_app"
    android:textColor="@color/prayer_widget_text_secondary"
    android:textSize="15sp"
    android:singleLine="false"
    android:maxLines="2"
    android:ellipsize="end" />
</LinearLayout>
