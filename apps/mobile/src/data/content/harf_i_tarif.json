  "sure": "10-15 dakika",
  "on_kosul": "Elif Ba harflerini tanıyor olmak",
  "aciklama": "Arapça'da 'el-' takısı (harf-i tarif) bazı harflerin önünde değişir. Bu derste neden değiştiğini ve hangi harflerde değiştiğini öğreneceksin.",
  "bolumler": [
    {
      "id": "giris",
      "tip": "bilgi",
      "baslik": "Harf-i Tarif Nedir?",
      "icerik": "Arapça'da 'el-' (ال) takısı İngilizcedeki 'the' gibi belirlilik kazandırır. Bunu her gün duyarsın: Er-Rahman, Es-Selam, El-Melik... Ama neden bazen 'el-', bazen 'er-', bazen 'es-' olur? İşte sırrı çok basit.",
      "ornek": {
        "dogru": "Er-Rahman ✓",
        "yanlis": "El-Rahman ✗",
        "aciklama": "'Ra' harfi şemsiye harf olduğu için 'l' sesi 'r'ye dönüşür."
      }
    },
    {
      "id": "kural",
      "tip": "kural",
      "baslik": "Temel Kural: Dilin Nereye Değiyor?",
      "icerik": "Kural aslında çok pratik. O harfi tek başına telaffuz ederken dilin damağına (üst damak ve diş etine) değiyorsa o harf ŞEMSİYE'dir — takı asimile olur. Değmiyorsa KAMERİYE'dir — takı olduğu gibi kalır.",
      "hafiza_ipucu": "Şemsiye = Güneş (şems). Güneş gibi parlak, dil çıkıyor öne. Kameriye = Ay (kamer). Ay gibi sessiz, dil geride kalıyor.",
      "gorsel_aciklama": "el + ش (şin) → eş-şin | el + ب (ba) → el-bau"
    },
