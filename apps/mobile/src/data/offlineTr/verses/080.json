[["(Peygamber) Yüzünü ekşitti ve döndü","Abese ve tevellâ","Surat astı ve yüz çevirdi."],["Kendisine âmâ geldi, diye","En câehül a'mâ","Kör ona geldi diye."],["Ne bilirsin, belki o temizlenecek","Ve ma yüdrike leallehu yezzekka","Ve sana ne bildirdi? Belki o arınır."],["Veya öğüt belleyecek de öğüt ona fayda verecek","Ev yezzekkeru fetenfeahu ez zikra","Yahut öğüt alacaktı da öğüt ona fayda verecekti."],["Ama buna ihtiyaç hissetmeyene gelince","Emma menistagna","Ama kendini müstağni görene gelince"],["Sen ona yöneliyorsun","Fe ente lehu tesadda","Sen ise o müstağni olana yöneliyorsun."],["Onun temizlenmemesinden sana ne","Ve ma aleyke ella yezzekka","Onun arınmamasından sana ne?"],["Ama sana can atarak gelen","Ve emma men caeke yes'a","Ve sana koşarak gelen kimseye gelince."],["Allah'tan korkarak gelmişken","Ve hüve yahşa","Ve o korkar."],["Sen onunla ilgilenmiyorsun","Fe ente anhu telehha","Sen ise ondan yüz çeviriyorsun."],["Hayır hayır, sakın. Çünkü o Kur'ân bir öğüttür","Kella inneha tezkiratun","Hayır, şüphesiz o bir öğüttür."],["Artık dileyen onu düşünür","Fe men şae zekerahu","Kim dilerse onu anar."],["O, değerli sahifelerdedir","Fi suhufin mükkerrametin","(Onlar) kerim kılınmış sayfalardadır."],["Yüksek tutulan tertemiz sahifelerde","Merfuatin mutahharatin","Yükseltilmiş, tertemizdir."],["Yazıcıların ellerindedir","Bi eydi seferatin","Elçilerin elleriyle yazılmıştır."],["Değerli, iyi yazıcıların","Kiramin beraratin","Değerli, iyi kimselerdir."],["O kahrolası insan, ne nankör şey","Kutilel insanü ma ekferahu","Öldürüldü insan, ne kadar nankör o!"],["O yaratan onu hangi şeyden yarattı","Min eyyi şey'in halekahu","Onu hangi şeyden yarattı?"],["Bir damla sudan, onu yarattı da biçime koydu","Min nutfetin halekahu fe kadderahu","Onu bir meni damlasından yarattı, sonra onu takdir etti."],["Sonra ona yolunu kolaylaştırdı","Sümme es sebile yesserahu","Sonra yolu ona kolaylaştırdı."],["Sonra onu öldürdü de kabre koydurdu","Sümme ematehu fe ekberahu","Sonra onu öldürdü de kabre koydu."],["Sonra dilediği vakit onu tekrar diriltir","Sümme iza şae enşerahu","Sonra dilediği zaman onu diriltir."],["Hayır hayır, doğrusu o, hiç Allah'ın emrini tam yerine getirmedi","Kella lemma yakdı ma emerahu","Hayır, ona emrettiğini henüz yerine getirmedi."],["Bir de o insan yiyeceğine baksın","Felyenzuril insanu ila taamihi","İnsan yiyeceğine bir baksın."],["Biz o suyu bol bol döktük","Enna sabebnel mae sabba","Şüphesiz biz suyu bolca döktük."],["Sonra toprağı nasıl da yardık","Sümme şakaknel erda şakka","Sonra yeri bir yarma ile yardık."],["Bu suretle orada ekinler bitirdik","Fe enbetna fiha habba","Sonra onda taneler bitirdik."],["Üzümler, yoncalar","Ve ınaben ve kadba","Üzüm ve yonca."],["Zeytinlikler, hurmalıklar","Ve zeytunen ve nahla","Zeytin ve hurma ağaçları"],["İri ve sık ağaçlı bahçeler","Ve hadaika gulba","Ve sık ağaçlı bahçeler."],["Meyveler, çayırlar bitirdik","Ve fakiheten ve ebba","Meyveler ve otlaklar bitirdik."],["Siz ve hayvanlarınız faydalansın diye","Metaan lekum ve li enamikum","Sizin ve hayvanlarınız için bir geçimlik olarak."],["Kulakları sağır eden o gürültü geldiğinde","Fe iza caetis sahha","Sağır edici ses geldiği zaman"],["O gün kişi kaçar, kardeşinden","Yevme yefirrul meru min ahihi","O gün kişi kardeşinden kaçar."],["Anasından, babasından","Ve ummihi ve ebihi","Ve annesinden ve babasından kaçar."],["Eşinden ve oğullarından","Ve sahibetihi ve benihi","Ve eşinden ve oğullarından kaçar."],["Onlardan her birinin o gün başından aşan işi vardır","Li kullimriin minhum yevmeizin şanun yuğnihi","Her kişinin o gün bir işi vardır onu meşgul eden."],["Yüzler var ki, o gün parıl parıl","Vucuhun yevmeizin musfirah","O gün birtakım yüzler parlayacaktır."],["Güler, sevinir","Dahiketun mustebşirah","Gülen, sevinçli olanlardır."],["Yüzler de var ki, o gün tozlanmış","Ve vucuhun yevmeizin aleyha gabarah","Ve yüzler o gün üzerlerinde toz vardır."],["Onları karanlık bürümüş","Terhekuha katerah","Onları karanlık kaplamıştır."],["İşte onlardır kâfirler, haktan sapanlar","Ulaike humul keferetul fecerah","İşte onlar kafirler, günahkarlar olanlardır."]]