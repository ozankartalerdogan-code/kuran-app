."},{"ayahNumber":2,"meal":"Hamd o âlemlerin Rabbi","reading":"Elhamdü lillahi rabbil alemin","literal":"Hamd, âlemlerin Rabbi Allah'a aittir."},{"ayahNumber":3,"meal":"O Rahmân ve Rahim","reading":"Errahmanirrahim","literal":"O, Rahman'dır, Rahim'dir."},{"ayahNumber":4,"meal":"O, din gününün maliki Allah'ın","reading":"Maliki yevmiddin","literal":"Dinin gününün sahibi."},{"ayahNumber":5,"meal":"Ancak sana ederiz kulluğu, ibadeti ve ancak senden dileriz yardımı, inayeti. (Ya Rab)","reading":"İyyake nabudu ve iyyake nestain","literal":"Yalnız Sana kulluk ederiz ve yalnız Senden yardım dileriz."},{"ayahNumber":6,"meal":"Hidayet eyle bizi doğru yola","reading":"İhdinas sıratel müstakim","literal":"Bizi doğru yola ilet."},{"ayahNumber":7,"meal":"O kendilerine nimet verdiğin mutlu kimselerin yoluna; o gazaba uğramışların ve o sapmışların yoluna değil","reading":"Sıratellezine enamte aleyhim gayril mağdubi aleyhim veleddallin","literal":"Kendilerine nimet verdiğin kimselerin yoluna; gazaba uğrayanların ve sapanların yoluna değil."}]},"114":{"surah":{"id":114,"name":"Nâs","arabicName":"الناس","verseCount":6,"revelationPlace":"Mekke"},"verses":[{"ayahNumber":1,"meal":"De ki: Sığınırım ben insanların Rabbine","reading":"Kul euzu birabbin nas","literal":"De ki sığınırım insanların rabbine."},{"ayahNumber":2,"meal":"İnsanların hükümdârına","reading":"Melikin nas","literal":"İnsanların hükümdarı"},{"ayahNumber":3,"meal":"İnsanların ilâhına","reading":"İlahin nas","literal":"İnsanların ilahına."},{"ayahNumber":4,"meal":"O sinsi vesvesecinin şerrinden","reading":"Min şerril vesvasil hannas","literal":"Sinsi vesvese verenin şerrinden."},{"ayahNumber":5,"meal":"O ki, insanların göğüslerine vesveseler fısıldar","reading":"Ellezi yuvesvisu fi sudurin nas","literal":"O ki insanların göğüslerine vesvese verir."},{"ayahNumber":6,"meal":"Gerek cinlerden, gerek insanlardan","reading":"Minel cinneti ven nas","literal":"Cinlerden ve insanlardan."}]}}}