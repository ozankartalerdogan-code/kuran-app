{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@quran-app/*": ["../../packages/*/src"]
    },
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "plugins": [{ "name": "expo/typescript-plugin" }]
  },
  "include": ["app", "src", "App.tsx"]
}
