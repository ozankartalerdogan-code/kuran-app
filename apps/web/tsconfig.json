{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "allowJs": true,
    "noEmit": true,
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    // *.dbtests.ts = *.test.ts dosyalarından taşınan, DB gerektiren test
    // gövdeleri (bkz. src/lib/testDbGuard.ts). Test dosyalarıyla aynı muameleyi
    // görürler; typecheck kapsamı taşıma öncesiyle birebir aynı kalır.
    "src/**/*.dbtests.ts",
    "src/__tests__/**"
  ]
}
